# ---- Datenbank ----
POSTGRES_DB=localnews
POSTGRES_USER=localnews
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Web ----
HTTP_PORT=80

# ---- Pipeline / AI ----
# Anbieter in der Weboberfläche (Einstellungen) wählbar – Keys NUR hier!
# LLM: mock | openai | openrouter | anthropic | ollama | custom
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Ollama: lokale Instanz, z.B. auf anderem Rechner im Netzwerk
# OLLAMA_BASE_URL=http://192.168.178.50:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# Custom: beliebiger OpenAI-kompatibler Endpunkt (LocalAI, vLLM, ...)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ---- TTS (in der UI wählbar: edge | openai | localai) ----
TTS_PROVIDER=edge
TTS_VOICE=de-DE-KatjaNeural
TTS_MODEL=tts-1
TTS_BASE_URL=

# ---- Video (in der UI wählbar: Renderer, Stil, Auflösung) ----
VIDEO_RESOLUTION=1920x1080
VIDEO_STYLE=news-dark
RENDERER_BACKEND=ffmpeg
RENDERER_WEBHOOK_URL=

# Scheduler: RSS-Import alle N Minuten
IMPORT_INTERVAL_MINUTES=60

# Zeitzone
TZ=Europe/Berlin
