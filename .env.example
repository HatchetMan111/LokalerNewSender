# ---- Datenbank ----
POSTGRES_DB=localnews
POSTGRES_USER=localnews
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Web ----
HTTP_PORT=80

# ---- Pipeline / AI ----
# LLM-Provider: mock | openai  (mock erzeugt template-basierte Scripts, funktioniert ohne API-Key)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# TTS (MVP: edge-tts, kostenlose Microsoft-Stimmen, de-DE)
TTS_PROVIDER=edge
TTS_VOICE=de-DE-KatjaNeural

# Rendering
VIDEO_RESOLUTION=1920x1080
VIDEO_FPS=25

# Scheduler: RSS-Import alle N Minuten
IMPORT_INTERVAL_MINUTES=60

# Zeitzone
TZ=Europe/Berlin
